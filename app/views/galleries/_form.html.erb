<%= form_with(model: gallery) do |form| %>
  <% if gallery.errors.any? %>
    <div class="alert alert-danger">
      <h2><%= pluralize(gallery.errors.count, "error") %> prohibited this gallery item from being saved:</h2>
      <ul>
        <% gallery.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :description, class: "form-label" %>
    <%= form.text_area :description, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :image_url, class: "form-label" %>
    <%= form.text_field :image_url, class: "form-control" %>
  </div>

  <div class="mt-4">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_path, class: "btn btn-outline-secondary ms-2" %>
  </div>
<% end %>
