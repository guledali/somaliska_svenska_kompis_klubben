<%= form_with(model: event) do |form| %>
  <% if event.errors.any? %>
    <div class="alert alert-danger mb-4">
      <h2 class="h5 mb-2">
        <%= pluralize(event.errors.count, "error") %> prohibited this event from being saved:
      </h2>
      <ul class="mb-0">
        <% event.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :title, class: "form-label" %>
    <%= form.text_field :title, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :description, class: "form-label" %>
    <%= form.text_area :description, rows: 4, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :date, class: "form-label" %>
    <%= form.datetime_field :date, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :location, class: "form-label" %>
    <%= form.text_field :location, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :capacity, class: "form-label" %>
    <%= form.number_field :capacity, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form.label :image, "Image URL", class: "form-label" %>
    <%= form.text_field :image, class: "form-control", placeholder: "https://example.com/image.jpg" %>
    <div class="form-text">Enter a URL for the event image</div>
  </div>

  <div class="d-flex justify-content-end gap-2">
    <%= link_to "Cancel", admin_path, class: "btn btn-secondary" %>
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
