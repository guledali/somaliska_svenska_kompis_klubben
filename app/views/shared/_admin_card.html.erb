<%# Reusable admin card component
    Parameters:
    - title: Card title
    - icon: Font Awesome icon class
    - color: Bootstrap color class (primary, success, warning, info)
    - items: Collection of items to display
    - new_path: Path for the "New" button
    - new_button_text: Text for the "New" button
    - edit_path_helper: Symbol for the edit path helper (e.g. :edit_activity_path)
    - delete_path_helper: Symbol for the delete path helper (e.g. :activity_path)
%>

<div class="card shadow-sm h-100">
  <div class="card-header bg-<%= color %> text-<%= color == 'warning' ? 'dark' : 'white' %>">
    <h2 class="card-title h4 mb-0">
      <i class="<%= icon %> me-2"></i><%= title %>
    </h2>
  </div>
  <div class="card-body">
    <div class="list-group list-group-flush">
      <% items.each do |item| %>
        <div class="list-group-item border border-primary border-2 mb-2 bg-light rounded">
          <% if (item.respond_to?(:image) && item.image.present?) || (item.respond_to?(:image_url) && item.image_url.present?) %>
            <div class="mb-2">
              <%= image_tag item.respond_to?(:image_url) ? item.image_url : item.image, class: "img-thumbnail", style: "max-height: 150px; width: auto;" %>
            </div>
          <% end %>

          <h3 class="h6 mb-1 fw-bold"><%= item.title || item.name %></h3>

          <% if item.respond_to?(:schedule) %>
            <div class="text-muted small mb-2">
              <i class="far fa-clock me-1"></i><%= item.schedule %>
            </div>
          <% end %>

          <% if item.respond_to?(:date) %>
            <div class="text-muted small mb-2">
              <i class="far fa-calendar me-1"></i><%= item.date.strftime("%B %d, %Y") %>
            </div>
          <% end %>

          <% if item.respond_to?(:email) %>
            <div class="text-muted small mb-2">
              <i class="fas fa-envelope me-1"></i><%= item.email %>
            </div>
          <% end %>

          <% if item.respond_to?(:description) %>
            <p class="small text-muted mb-2"><%= truncate(item.description, length: 100) %></p>
          <% end %>

          <% if item.respond_to?(:message) %>
            <p class="small mb-2 bg-white p-2 rounded">
              <i class="fas fa-comment me-1"></i><%= item.message %>
            </p>
          <% end %>

          <div class="d-flex justify-content-between align-items-center mt-3">
            <div>
              <% if edit_path_helper %>
                <%= link_to send(edit_path_helper, item), class: "btn btn-primary rounded me-2" do %>
                  <i class="fas fa-edit me-1"></i>Edit
                <% end %>
              <% end %>
            </div>
            <div>
              <%= button_to send(delete_path_helper, item), method: :delete, class: "btn btn-sm btn-outline-danger", form: { data: { turbo_confirm: "Are you sure?" } } do %>
                <i class="fas fa-trash-alt me-1"></i>Delete
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <% if new_path.present? %>
      <%= link_to new_path, class: "btn btn-#{color} mt-3 w-100" do %>
        <i class="fas fa-plus me-1"></i><%= new_button_text %>
      <% end %>
    <% end %>
  </div>
</div>
